<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<div class="modal-overlay" id="modal-overlay">
    <div class="modal-box">
        <span class="modal-icone">⚠️</span>
        <h3>Confirmation requise</h3>
        <p id="modal-message"></p>
        <div class="modal-actions">
            <button class="modal-btn-annuler" onclick="fermerConfirmation(false)">Annuler</button>
            <button class="modal-btn-confirmer" id="modal-btn-confirmer" onclick="fermerConfirmation(true)">Supprimer</button>
        </div>
    </div>
</div>